# Target System & Subtarget (x86 64-bit)
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Base System Features & CPU Power Management
CONFIG_PACKAGE_kmod-cpu-freq=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_intel-microcode=y

# USB Ethernet Drivers (RTL8152 & AX88719 / AX88179)
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-ax88179-178a=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# Wi-Fi Drivers & HostAPD (Ath10k / QCA6174)
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_ath10k-firmware-qca6174=y
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# Speed & Queue Management (SQM, CAKE, cake-autorate)
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_cake-autorate=y

# Essential Network & Proxy Tools

CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_tailscale=y

# System Tools, Monitoring & Containers
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-fileassistant=y
CONFIG_PACKAGE_nano=y

# Docker Environment
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y
